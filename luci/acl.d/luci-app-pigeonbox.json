{
	"luci-app-pigeonbox": {
		"description": "Grant access to PigeonBox service page",
		"read": {
			"ubus": {
				"luci": ["getInitList"],
				"service": ["list"]
			},
			"uci": ["pigeonbox"]
		},
		"write": {
			"ubus": {
				"file": ["exec"],
				"uci": ["apply", "confirm"]
			},
			"uci": ["pigeonbox"],
			"file": {
				"/etc/init.d/pigeonbox": ["exec"]
			}
		}
	}
}
