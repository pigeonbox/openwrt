#!/bin/sh /etc/rc.common
# PigeonBox procd init 脚本(ipk 安装为 /etc/init.d/pigeonbox)
#
# 配置面:UCI /etc/config/pigeonbox → PB_* 环境变量注入(core envBindings,
# env 优先级高于配置文件)。可选变量只在非空时注入——viper 默认 AllowEmptyEnv=false,
# 空串 env 会被忽略,显式判空语义更清晰。
#
# 高级配置:创建 /etc/pigeonbox/config.yaml 后自动生效(二进制 --config),
# 适用于 S3/OIDC/联邦等 UCI 面未覆盖的项。

USE_PROCD=1
START=99
STOP=15

PROG=/usr/bin/pigeonbox

start_service() {
	local enabled port host data_dir open_upload admin_password base_url
	local redis_enabled redis_host redis_port redis_password

	config_load pigeonbox

	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	config_get port main port 12345
	config_get host main host "0.0.0.0"
	config_get data_dir main data_dir "/etc/pigeonbox/data"
	config_get_bool open_upload main open_upload 1
	config_get admin_password main admin_password ""
	config_get base_url main base_url ""

	config_get_bool redis_enabled redis enabled 1
	config_get redis_host redis host "127.0.0.1"
	config_get redis_port redis port 6379
	config_get redis_password redis password ""

	# PigeonBeam 信鸽直传网页客户端(A2 内嵌):独立 procd 实例;enabled=0 或
	# /usr/bin/p2pcweb 缺失时优雅跳过(老版本升级兼容)。
	config_get_bool beam_enabled beam enabled 1
	config_get beam_port beam port 12348

	mkdir -m 0755 -p "$data_dir"

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		PB_SERVER_HOST="$host" \
		PB_SERVER_PORT="$port" \
		PB_SERVER_MODE=release \
		PB_PRODUCTION=1 \
		PB_DATABASE_DRIVER=sqlite \
		PB_DATABASE_DB_NAME="$data_dir/fileCodeBox.db" \
		PB_DATA_PATH="$data_dir" \
		PB_STORAGE_PATH="$data_dir/files" \
		PB_OPEN_UPLOAD="$open_upload" \
		PB_P2PCWEB_PORT="$beam_port"

	# 可选项:非空才注入
	[ -n "$admin_password" ] && procd_append_param env PB_ADMIN_PASSWORD="$admin_password"
	# 生产门禁逃生门(core v0.14.9):未注入 admin_password 时放行 /setup 首启向导
	# 建号——否则全新安装会被 ErrInsecureDefaultAdmin 拒启(1.14.3 冒烟暴露)。
	# 升级场景库中已有 admin,本 env 无副作用。
	[ -z "$admin_password" ] && procd_append_param env PB_DISABLE_DEFAULT_ADMIN=true
	[ -n "$base_url" ] && procd_append_param env PB_SERVER_BASE_URL="$base_url"
	if [ "$redis_enabled" = "1" ]; then
		procd_append_param env PB_REDIS_HOST="$redis_host" PB_REDIS_PORT="$redis_port"
		[ -n "$redis_password" ] && procd_append_param env PB_REDIS_PASSWORD="$redis_password"
	fi

	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# PigeonBeam 实例(令牌/配置落数据目录,procd respawn 自愈;与 fnos/qnap 同构)
	if [ "$beam_enabled" = "1" ] && [ -x /usr/bin/p2pcweb ]; then
		procd_open_instance
		procd_set_param command /usr/bin/p2pcweb
		procd_set_param args \
			--addr "0.0.0.0:${beam_port}" \
			--token-file "$data_dir/.p2pcweb_token" \
			--config-file "$data_dir/p2pcweb.json" \
			--out "$data_dir" \
			--no-open
		procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	# 出厂预接线:把 Box 地址 + 一把专用 API Key 预置给 PigeonBeam
	# (Beam 的「文件柜」tab 不再要手填地址与 Key)。
	# ⚠️ **后台跑**:Box 与 p2pcweb 由 procd **异步**拉起 ⇒ 调用时刻可能早于就绪
	#   ⇒ 脚本自己会等(最多 30s)⇒ 前台调用会阻塞服务启动。
	# ⚠️ admin 口令来自 UCI(main admin_password)⇒ 空则脚本自动跳过(未建号场景)。
	if [ "$beam_enabled" = "1" ] && [ -x /usr/bin/prewire_beam_box ]; then
		PB_ADMIN_PASSWORD="$admin_password" \
		PB_SERVER_PORT="$port" \
		PB_P2PCWEB_PORT="$beam_port" \
		PB_DATA_PATH="$data_dir" \
			nohup /usr/bin/prewire_beam_box >>/var/log/pigeonbox-prewire.log 2>&1 &
	fi
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger pigeonbox
}
