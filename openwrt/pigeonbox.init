#!/bin/sh /etc/rc.common
# PigeonBox procd init 脚本(ipk 安装为 /etc/init.d/pigeonbox)
#
# 配置面:UCI /etc/config/pigeonbox → PB_* 环境变量注入(core envBindings,
# env 优先级高于配置文件)。可选变量只在非空时注入——viper 默认 AllowEmptyEnv=false,
# 空串 env 会被忽略,显式判空语义更清晰。
#
# 高级配置:创建 /etc/pigeonbox/config.yaml 后自动生效(二进制 --config),
# 适用于 S3/OIDC/联邦等 UCI 面未覆盖的项。
#
# shellcheck disable=SC2034  # USE_PROCD/START/STOP 是 rc.common 的外部契约(本文件内不引用)
# shellcheck disable=SC3043  # `local`:busybox ash 支持(OpenWrt rc.common 脚本通行写法);POSIX 不保证,但设备侧就是 ash
# shellcheck disable=SC2154  # beam_enabled/beam_port 由 config_get/config_get_bool 赋值,shellcheck 看不见

USE_PROCD=1
START=99
STOP=15

PROG=/usr/bin/pigeonbox

# ── shellkit POSIX 子集（设备侧唯一可用的 shellkit 形态）──────────────────
#   上游 shellkit 主库是 Bash 3.2+ 基线(数组/printf -v/local -n 等)在 busybox ash 上
#   **根本解析不了**(不是运行报错,是脚本起不来)⇒ 设备侧只能用 POSIX 子集
#   (lib/posix/shellkit-posix.sh,纯 POSIX sh 语法)。本仓副本随包装在
#   /usr/lib/pigeonbox/shellkit-posix.sh(build-ipk.sh / build-apk.sh 安装)。
#
#   探测序：① 环境变量 PB_SHELLKIT_POSIX ② 脚本同目录 ③ 同目录 lib/ ④ 包内落点。
#   ⚠️ rc.common 用 `.` **source** 本脚本 ⇒ `$0` 是 rc.common 的路径、不是本脚本的
#      ⇒ 同目录(②③)落空 ⇒ 靠 ④ 包内落点命中。
#   ⚠️ **缺失即退 5(fail-closed)**:装的是不完整的包 ⇒ 服务不许带着半个包起。
#      退出码 5 会被 postinst 的「启动失败判红」接住(openwrt#198)⇒ 现场看得见。
#   ⚠️ 退 5 之前**不能**用 shellkit 的 die/fail —— 那两个函数就在缺掉的那个库里。
_sk_dir="$(dirname "$0")"
_sk_lib=""
for _sk_c in \
    "${PB_SHELLKIT_POSIX:-}" \
    "${_sk_dir}/shellkit-posix.sh" \
    "${_sk_dir}/lib/shellkit-posix.sh" \
    "/usr/lib/pigeonbox/shellkit-posix.sh"
do
    if [ -n "$_sk_c" ] && [ -r "$_sk_c" ]; then _sk_lib="$_sk_c"; break; fi
done
if [ -z "$_sk_lib" ]; then
    echo "缺 shellkit POSIX 子集（装的是不完整的包）" >&2
    exit 5
fi
# 落点是运行时探测出来的 ⇒ shellcheck 追不动,显式声明不追
# shellcheck source=/dev/null
. "$_sk_lib"

# 默认数据目录自动选定(iStore 上架 review 建议,参考 istoreos-app-hub codeserver 的做法):
#   0. 已有存量数据(/etc/pigeonbox/data 已存在)⇒ 沿用,绝不搬家(升级不丢数据;
#      从未改过配置的存量安装升级后 conffile 会被新版替换为空值,没有这条就会被静默迁移)
#   1. iStoreOS quickstart 明确指定的 Configs 目录 → <conf_dir>/Pigeonbox
#   2. 首个可用数据盘(可写且可用空间 > 1G)      → <mnt>/Configs/Pigeonbox
#   3. 都没有                                   → /etc/pigeonbox/data(overlay 兜底,同旧行为)
# 选定后回填 UCI 固化(pigeonbox.main.data_dir),避免拔盘/换挂载序后目录漂移、数据看起来丢失。
resolve_default_data_dir() {
	local conf_dir mnt avail
	[ -d /etc/pigeonbox/data ] && { echo "/etc/pigeonbox/data"; return 0; }
	conf_dir="$(uci -q get quickstart.main.conf_dir)"
	[ -n "$conf_dir" ] && { echo "$conf_dir/Pigeonbox"; return 0; }
	for mnt in /mnt/*; do
		[ -d "$mnt" ] && [ -w "$mnt" ] || continue
		avail="$(df -k "$mnt" 2>/dev/null | awk 'NR==2 {print $4}')"
		case "$avail" in
			''|*[!0-9]*) continue ;;
		esac
		[ "$avail" -gt 1048576 ] && { echo "$mnt/Configs/Pigeonbox"; return 0; }
	done
	echo "/etc/pigeonbox/data"
}

start_service() {
	local enabled port host data_dir open_upload admin_password base_url
	local redis_enabled redis_host redis_port redis_password

	config_load pigeonbox

	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	config_get port main port 12345
	config_get host main host "0.0.0.0"
	# 数据目录留空=自动选定(见 resolve_default_data_dir)并回填 UCI 固化
	config_get data_dir main data_dir ""
	if [ -z "$data_dir" ]; then
		data_dir="$(resolve_default_data_dir)"
		# 回填固化:本次起生效的目录写回配置(失败不致命,仅下次启动重新选一次)
		uci -q set pigeonbox.main.data_dir="$data_dir" && uci -q commit pigeonbox
	fi
	config_get_bool open_upload main open_upload 1
	config_get admin_password main admin_password ""
	config_get base_url main base_url ""

	config_get_bool redis_enabled redis enabled 1
	config_get redis_host redis host "127.0.0.1"
	config_get redis_port redis port 6379
	config_get redis_password redis password ""

	# PigeonBeam 信鸽直传网页客户端(A2 内嵌):独立 procd 实例;enabled=0 或
	# /usr/bin/p2pcweb 缺失时优雅跳过(老版本升级兼容)。
	config_get_bool beam_enabled beam enabled 1
	config_get beam_port beam port 12348

	# 目录创建走 shellkit 的 fs_ensure_dir(等价:已存在即成功、建父目录;不存在时
	# mkdir -p 之后 chmod 0755 ⇒ 最终权限与原 `mkdir -m 0755 -p` 一致)。
	# ⚠️ 失败**不中止**(原来的 mkdir 失败也只是继续往下走)⇒ 但必须留痕:
	#    原来靠 mkdir 自己往 stderr 报错,换成 fs_ensure_dir 后要自己报,
	#    否则「数据目录建不出来」会从可见变成静默。
	fs_ensure_dir "$data_dir" 0755 || log_warn "数据目录创建失败: $data_dir"

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		PB_SERVER_HOST="$host" \
		PB_SERVER_PORT="$port" \
		PB_SERVER_MODE=release \
		PB_PRODUCTION=1 \
		PB_DATABASE_DRIVER=sqlite \
		PB_DATABASE_DB_NAME="$data_dir/fileCodeBox.db" \
		PB_DATA_PATH="$data_dir" \
		PB_STORAGE_PATH="$data_dir/files" \
		PB_OPEN_UPLOAD="$open_upload" \
		PB_P2PCWEB_PORT="$beam_port"

	# 可选项:非空才注入
	[ -n "$admin_password" ] && procd_append_param env PB_ADMIN_PASSWORD="$admin_password"
	# 生产门禁逃生门(core v0.14.9):未注入 admin_password 时放行 /setup 首启向导
	# 建号——否则全新安装会被 ErrInsecureDefaultAdmin 拒启(1.14.3 冒烟暴露)。
	# 升级场景库中已有 admin,本 env 无副作用。
	[ -z "$admin_password" ] && procd_append_param env PB_DISABLE_DEFAULT_ADMIN=true
	[ -n "$base_url" ] && procd_append_param env PB_SERVER_BASE_URL="$base_url"
	if [ "$redis_enabled" = "1" ]; then
		procd_append_param env PB_REDIS_HOST="$redis_host" PB_REDIS_PORT="$redis_port"
		[ -n "$redis_password" ] && procd_append_param env PB_REDIS_PASSWORD="$redis_password"
	fi

	# shellcheck disable=SC2086  # respawn 三元组按 procd 语义拆成三个参数 ⇒ 故意不加引号(保持原样)
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# PigeonBeam 实例(令牌/配置落数据目录,procd respawn 自愈;与 fnos/qnap 同构)
	# ⚠️ procd **没有 args 参数**——`procd_set_param args` 会被静默忽略 ⇒ 端口/令牌文件/
	# 接收目录全部丢失、p2pcweb 以默认参数裸跑,/beam 入口 503(iStore 上架 review 真机复现)。
	# 参数必须全部并入 command。
	if [ "$beam_enabled" = "1" ] && [ -x /usr/bin/p2pcweb ]; then
		procd_open_instance
		procd_set_param command /usr/bin/p2pcweb \
			--addr "0.0.0.0:${beam_port}" \
			--token-file "$data_dir/.p2pcweb_token" \
			--config-file "$data_dir/p2pcweb.json" \
			--out "$data_dir" \
			--no-open
		# shellcheck disable=SC2086  # respawn 三元组按 procd 语义拆成三个参数 ⇒ 故意不加引号(保持原样)
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	# 出厂预接线:把 Box 地址 + 一把专用 API Key 预置给 PigeonBeam
	# (Beam 的「文件柜」tab 不再要手填地址与 Key)。
	# ⚠️ **后台跑**:Box 与 p2pcweb 由 procd **异步**拉起 ⇒ 调用时刻可能早于就绪
	#   ⇒ 脚本自己会等(最多 30s)⇒ 前台调用会阻塞服务启动。
	# ⚠️ admin 口令来自 UCI(main admin_password)⇒ 空则脚本自动跳过(未建号场景)。
	# ⚠️ **显式 `sh` 调预接线**(openwrt#215 的根因修复):OpenWrt **没有 bash** ⇒
	#   直接执行会按脚本 shebang 找解释器 ⇒ 原 shebang 是 `#!/usr/bin/env bash`
	#   ⇒ exec 失败(exit 127,实测 `env: can't execute 'bash'`)⇒ **出厂预接线在真机
	#   静默空跑**(CI 只断言文件存在,从未执行过它)。现在脚本本体已是 POSIX sh
	#   (`#!/bin/sh`),这里再显式 `sh` ⇒ 与 shebang 无关地保证是 POSIX shell。
	if [ "$beam_enabled" = "1" ] && [ -x /usr/bin/prewire_beam_box ]; then
		PB_ADMIN_PASSWORD="$admin_password" \
		PB_SERVER_PORT="$port" \
		PB_P2PCWEB_PORT="$beam_port" \
		PB_DATA_PATH="$data_dir" \
			nohup sh /usr/bin/prewire_beam_box >>/var/log/pigeonbox-prewire.log 2>&1 &
	fi
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger pigeonbox
}
