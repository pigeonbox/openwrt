# PigeonBox OpenWrt/iStoreOS 配置(UCI)
# 修改后执行:/etc/init.d/pigeonbox reload
#
# 数据目录建议:默认在 overlay 上,大量文件分享请指到大容量数据盘,
# 如 /mnt/sda1/pigeonbox(iStoreOS 自动挂载盘见 系统→挂载点)。

config main 'main'
	# 服务总开关(配合 /etc/init.d/pigeonbox enable/start)
	option enabled '1'
	# 监听端口/地址;Web 界面与 API 同端口,访问 http://<路由器IP>:12345
	option port '12345'
	option host '0.0.0.0'
	# 数据目录(SQLite 数据库 + 上传文件 + 自动生成的 JWT 密钥)
	option data_dir '/etc/pigeonbox/data'
	# 允许匿名上传(访客创建分享)
	option open_upload '1'
	# 管理员密码(留空=启动后打开站点走 /setup 首启向导当场建号;3.0.0 起不再有默认口令)
	option admin_password ''
	# 站点对外 URL(直链下载/presign 需要;局域网直访可留空)
	option base_url ''

config redis 'redis'
	# Redis 承担取件码映射持久化(保重启不丢未取件码);关闭后服务仍可用。
	# core 单机内存模式列车后,关闭=进程内 KV(匿名取件可用、重启丢失映射);
	# 当前钉版(core v0.13.0)下关闭=匿名取件不可用
	# 依赖包 redis-server(OpenWrt 官方源)会随本包自动安装
	option enabled '1'
	option host '127.0.0.1'
	option port '6379'
	option password ''

config beam 'beam'
	# PigeonBeam 信鸽直传网页客户端(设备端到端互传;入口 http://<路由器IP>:12345/beam)。
	# enabled=0 或包内无 /usr/bin/p2pcweb 时不启动(优雅跳过)。
	option enabled '1'
	# LAN 监听端口(另经主服务 /beam 入口跳转至此)
	option port '12348'
